# Copy this file to `.env` and adjust values before `make up`.
# All values below are local development defaults only; never use them in a
# shared or production deployment.

# PostgreSQL
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse
POSTGRES_DB=lakehouse

# MinIO (S3-compatible object store)
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=lakehouse
MINIO_BUCKET=lakehouse

# API / worker logging
LOG_LEVEL=info

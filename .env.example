# Local development configuration reference.
#
# You normally do not need to create a `.env` by hand: `make up` runs
# `scripts/genenv.sh`, which writes a gitignored `.env` with freshly generated
# local-only secrets on first boot and preserves any values already pinned
# there. This file documents the variables and is deliberately free of usable
# credentials — never commit a real password, key, or token here.
#
# All values below are local development defaults only; they are bound to
# loopback (127.0.0.1) by docker-compose.yml. Never reuse them in a shared or
# production deployment.

# PostgreSQL — `POSTGRES_PASSWORD` is a secret and is generated by `make up`.
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=
POSTGRES_DB=lakehouse

# MinIO (S3-compatible object store) — `MINIO_ROOT_PASSWORD` is a secret and is
# generated by `make up`.
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=lakehouse

# API / worker logging
LOG_LEVEL=info

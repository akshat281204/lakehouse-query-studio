{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::lakehouse"]
    },
    {
      "Sid": "ReadDatasetsAndResults",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::lakehouse/lake/*", "arn:aws:s3:::lakehouse/exports/*", "arn:aws:s3:::lakehouse/data/*"]
    },
    {
      "Sid": "UploadsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:GetObject"],
      "Resource": ["arn:aws:s3:::lakehouse/uploads/*"]
    }
  ]
}

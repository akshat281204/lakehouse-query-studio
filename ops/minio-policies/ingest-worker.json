{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::lakehouse"]
    },
    {
      "Sid": "ReadInputs",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::lakehouse/uploads/*", "arn:aws:s3:::lakehouse/data/*"]
    },
    {
      "Sid": "WriteLakeAndStaging",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::lakehouse/lake/*", "arn:aws:s3:::lakehouse/staging/*"]
    },
    {
      "Sid": "SweepExports",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::lakehouse/exports/*"]
    }
  ]
}

{
  "uid": "lqs-ops",
  "title": "Lakehouse service operations",
  "tags": [
    "lakehouse"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Dependencies (1 = ready)",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lqs_dependency_up",
          "legendFormat": "{{dependency}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Workers up",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(lqs_worker_up)",
          "legendFormat": "workers",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lqs_queue_depth",
          "legendFormat": "{{kind}} {{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Worker query slots in use",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(lqs_worker_inflight_queries)",
          "legendFormat": "running",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(lqs_worker_query_slots)",
          "legendFormat": "slots",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Query outcomes / s",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(lqs_query_jobs_total[5m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Query failures by reason / s",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(lqs_query_failures_total[5m]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Query latency p50 / p95",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(lqs_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lqs_query_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cancel requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(lqs_query_cancel_requests_total[5m])",
          "legendFormat": "cancels",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API requests / s by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (rate(lqs_http_requests_total[5m]))",
          "legendFormat": "{{class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API latency p95 by route",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(lqs_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Ingestion outcomes / s",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(lqs_ingest_jobs_total[5m]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Retention sweeps (objects/rows removed)",
      "datasource": {
        "type": "prometheus",
        "uid": "lqs-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(lqs_sweeper_deleted_total[1h]))",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "lqs-prometheus"
          }
        }
      ]
    }
  ]
}